# AIMA – Umgebungskonfiguration (Vorlage)
# Kopieren nach .env und lokale Werte eintragen. .env wird NIE committet.
# Diese Vorlage waechst mit jeder Phase (vollstaendig ab Phase 1).

# --- Anwendung ---
AIMA_ENV=development          # development | production
LOG_LEVEL=INFO

# --- Datenbank (ab Phase 1/2) ---
# PostgreSQL 16 + pgvector
DATABASE_URL=postgresql+psycopg://aima:CHANGE_ME@localhost:5432/aima

# --- Redis / Celery (ab Phase 1) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT (ab Phase 2) ---
JWT_SECRET_KEY=CHANGE_ME
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- RunPod (Serverless, ab Phase 3) ---
# API-Key aus der RunPod-Console. Endpoint-IDs werden manuell angelegt
# (siehe scripts/bootstrap-runpod.py) und hier eingetragen.
RUNPOD_API_KEY=CHANGE_ME
RUNPOD_ENDPOINT_NSFW=
RUNPOD_ENDPOINT_PERSONS=
RUNPOD_ENDPOINT_REID=
RUNPOD_ENDPOINT_OBJECTS=

# --- Externe KI-Backends (optional, ab Phase 6) ---
# Nur Kontextanalyse/Bildbeschreibung. NIE Gesichts- oder NSFW-Daten.
GOOGLE_AI_API_KEY=
XAI_API_KEY=
